# Copy this file to .env and fill it in.

# Required. One or more API keys, separated by commas. Make one with: npm run gen-key
OSSS_API_KEYS=

# Address and port the server listens on.
OSSS_HOST=0.0.0.0
OSSS_PORT=8787

# Where the SQLite database file is stored.
OSSS_DB_PATH=data/osss.db

# Largest request body the server accepts, in bytes (default 16 MB).
OSSS_MAX_BODY_BYTES=16777216
