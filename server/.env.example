# Copy this file to .env and fill it in.

# One or more admin API keys, separated by commas. Make one with: npm run gen-key
# Admin keys can read and write every store and use the dashboard.
OSSS_API_KEYS=

# Optional. A JSON file of extra keys with limited access. See keys.example.json.
# OSSS_KEYS_FILE=keys.json

# Address and port the server listens on.
OSSS_HOST=0.0.0.0
OSSS_PORT=8787

# Where the SQLite database file is stored.
OSSS_DB_PATH=data/osss.db

# Largest request body the server accepts, in bytes (default 16 MB).
OSSS_MAX_BODY_BYTES=16777216

# Automatic backups. Set the interval in hours to turn them on (0 = off).
OSSS_BACKUP_DIR=backups
OSSS_BACKUP_INTERVAL_HOURS=0
# How many automatic backups to keep (0 = keep all).
OSSS_BACKUP_KEEP=14
